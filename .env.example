# Banco PostgreSQL. Use somente uma branch isolada de desenvolvimento local.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"

# Gere um segredo aleatório com pelo menos 32 caracteres para cada ambiente.
BETTER_AUTH_SECRET="substitua-por-um-segredo-aleatorio"

# URL pública do ambiente. Para desenvolvimento local:
BETTER_AUTH_URL="http://localhost:3001"

# Integracao opcional de telefonia. O fluxo manual funciona sem estas variaveis.
API4COM_TOKEN="token-ficticio"
API4COM_EXTENSION="0000"
API4COM_WEBHOOK_SECRET="segredo-ficticio-para-o-webhook"
