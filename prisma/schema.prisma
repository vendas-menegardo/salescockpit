generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportJobStatus {
  PREPARING
  READY
  PROCESSING
  PAUSED
  COMPLETED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role, banned])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Base {
  id          String  @id @default(cuid())
  name        String
  description String?

  segment String?
  state   String?
  city    String?

  isActive Boolean @default(false)

  companiesCount Int @default(0)

  companies  BaseCompany[]
  importJobs ImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(cuid())

  corporateName String
  tradeName     String?

  cnpj String? @unique

  email   String?
  phone   String?
  website String?

  segment String?

  city  String?
  state String?

  contactName String?

  bases BaseCompany[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cnpj])
  @@index([city])
}

model BaseCompany {
  baseId    String
  companyId String

  status String? @default("Novo")

  base    Base    @relation(fields: [baseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([baseId, companyId])
  @@index([companyId])
}

model ImportJob {
  id                      String          @id
  baseId                  String
  fileName                String
  fileHash                String
  status                  ImportJobStatus @default(PREPARING)
  totalRows               Int
  eligibleRows            Int
  stagedRows              Int             @default(0)
  processedRows           Int             @default(0)
  invalidIgnored          Int
  duplicatesIgnored       Int
  emptyRowsIgnored        Int
  companiesCreated        Int             @default(0)
  existingCompaniesReused Int             @default(0)
  linksCreated            Int             @default(0)
  alreadyInBase           Int             @default(0)
  conflictsPreserved      Int             @default(0)
  failures                Int             @default(0)
  lastError               String?

  base Base           @relation(fields: [baseId], references: [id], onDelete: Cascade)
  rows ImportJobRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseId, fileHash])
  @@index([status, updatedAt])
}

model ImportJobRow {
  jobId         String
  rowNumber     Int
  cnpj          String
  corporateName String
  tradeName     String
  segment       String
  city          String
  state         String
  phone         String
  email         String
  website       String
  processedAt   DateTime?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, rowNumber])
  @@unique([jobId, cnpj])
  @@index([jobId, processedAt, rowNumber])
}
